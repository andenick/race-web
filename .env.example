# race-web (DuBois) — per-host compose variables. Copy to `.env` beside
# docker-compose.yml. The `.env` is PER-HOST and is never committed with a
# host-specific value; this example carries no absolute path.
#
# Both variables below are already set to their in-container defaults by
# docker-compose.yml, so a plain `docker compose up` works without a `.env`.
# Override them only when you mount the telemetry volume somewhere else.

# First-party usage database written by the app inside the container.
CARSON_TELEMETRY_DB=/var/lib/carson/telemetry.db

# Directory holding the daily client-hash salt. Must be writable and must be
# shared by every worker so they agree on the day's salt. There is no secret to
# put here: the salt is generated at runtime, rotates by UTC day, and a raw
# client IP is never stored.
CARSON_TELEMETRY_SALT_DIR=/var/lib/carson

# Host port the site is published on (see docker-compose.yml).
# RACE_PORT=8090
